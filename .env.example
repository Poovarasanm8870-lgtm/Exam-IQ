# ExamiQ Official Assessment Platform - Environment Credentials
# Copy this file to '.env' in your project root or backend folder and update the SMTP values.

# SMTP Configuration
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_EMAIL=your_email@gmail.com
SMTP_PASSWORD=your_smtp_app_password
SMTP_USE_TLS=True

# Groq LLM API Key
GROQ_API_KEY=YOUR_GROQ_API_KEY_HERE
